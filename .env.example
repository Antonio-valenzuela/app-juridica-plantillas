# ==============================================================================
# APP-plantillas - Variables de Entorno
# Configuración exclusiva para el Módulo de Machotes, Motor Jurídico y Asistente IA
# ==============================================================================

# Persistencia LOCAL (SQLite). Ya no se usa DATABASE_URL ni ninguna base remota (Neon/Postgres).
# Por defecto la base vive en %LOCALAPPDATA%\LexPlantillas\data\lexplantillas.db (Windows).
# Solo defina estas variables si necesita otra ubicación; nunca dentro de node_modules.
# LEXPLANTILLAS_STORAGE_ROOT=
# LEXPLANTILLAS_DATABASE_PATH=

# Proveedores de Inteligencia Artificial
# La generación recorre AI_PROVIDER_CHAIN en orden: si un proveedor no responde, no tiene clave o falla,
# pasa al siguiente; "local" (determinístico, sin red) es siempre el último recurso.
# Solo se usan proveedores con clave configurada y SOLO si el abogado autoriza enviar el expediente.
AI_PROVIDER_CHAIN="nvidia,gemini,groq,local"
# NVIDIA al frente de la cadena (si es "false", rige el orden de AI_PROVIDER_CHAIN tal cual).
NVIDIA_PRIMARY_PROVIDER="true"

# NVIDIA AI Foundation
NVIDIA_API_KEY=
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Google Gemini (opcional; respaldo)
GEMINI_API_KEY=
# GEMINI_MODEL="gemini-2.5-flash"

# Groq (opcional; respaldo)
GROQ_API_KEY=
# GROQ_MODEL=

# Configuración del Entorno
NODE_ENV=development
PORT=3200
NEXT_PUBLIC_APP_URL="http://localhost:3200"

# Seguridad y Workspace
# Obligatorio en producción; genere un valor aleatorio fuera de este archivo.
ADMIN_TOKEN=
# Solo habilitar explícitamente en desarrollo local; nunca en staging/producción.
ALLOW_DEV_ADMIN_TOKEN="false"
# Si es "true", permite fallback a identidad demo en desarrollo y habilita confianza en headers x-user-id/x-org-id solo con x-admin-token válido.
# En producción debe ser "false" para impedir suplantación y exponer 401 en lugar de demo silencioso.
DEMO_MODE_ENABLED="false"
DEFAULT_ORG_ID="demo-legal"
DEFAULT_USER_ID="demo-user-1"
