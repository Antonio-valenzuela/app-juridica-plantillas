# ==============================================================================
# APP-plantillas - Variables de Entorno
# Configuración exclusiva para el Módulo de Machotes, Motor Jurídico y Asistente IA
# ==============================================================================

# URL de Base de Datos PostgreSQL con Prisma (Opcional - el sistema cuenta con fallback local)
# Configure el valor real mediante el gestor de secretos o en .env local; no lo incluya aquí.
DATABASE_URL=

# Proveedores de Inteligencia Artificial — NVIDIA ONLY
# NVIDIA AI Foundation (único provider externo) — LOCAL como fallback determinístico
NVIDIA_API_KEY=
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"
NVIDIA_PRIMARY_PROVIDER="true"
AI_PROVIDER_CHAIN="nvidia,local"
# Obsoletos (mantener vacíos para compatibilidad, no usados en runtime NVIDIA ONLY):
# GEMINI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY ya no son requeridos

# Configuración del Entorno
NODE_ENV=development
PORT=3200
NEXT_PUBLIC_APP_URL="http://localhost:3200"

# Seguridad y Workspace
# Obligatorio en producción; genere un valor aleatorio fuera de este archivo.
ADMIN_TOKEN=
# Solo habilitar explícitamente en desarrollo local; nunca en staging/producción.
ALLOW_DEV_ADMIN_TOKEN="false"
# Si es "true", permite fallback a identidad demo en desarrollo y habilita confianza en headers x-user-id/x-org-id solo con x-admin-token válido.
# En producción debe ser "false" para impedir suplantación y exponer 401 en lugar de demo silencioso.
DEMO_MODE_ENABLED="false"
DEFAULT_ORG_ID="demo-legal"
DEFAULT_USER_ID="demo-user-1"
